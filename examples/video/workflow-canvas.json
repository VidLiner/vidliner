{
  "schema_version": "vidliner.workflow/v1",
  "name": "VidLiner video canvas",
  "nodes": [{
    "id": "plan", "operator": "video.plan_variants", "operator_version": "1.0.0", "stage": "plan",
    "config": {"spec": {"id": "canvas", "seed": 42, "operators": [{"name": "format.reframe", "axis": "format", "domains": {"aspect": ["1:1"]}}]}},
    "outputs": {"variants": "video_variants", "pairs": "contrast_pairs"},
